index 1495bc8..bf9af87 100644
--- a/inventory.py
+++ b/inventory.py
@@ -17,3 +17,8 @@ def remove_item(stock, name, qty):
 def total_quantity(stock):
     """Units on hand across every item."""
     return sum(stock.values())
+
+
+def low_stock(stock, below):
+    """Names of items with fewer than `below` units, fewest first, then alphabetical."""
+    return sorted((n for n, q in stock.items() if q < below), key=lambda n: (stock[n], n))
