+    def test_low_stock_lists_names_and_changes_nothing(self):
+        self.run_cli("add", "pear", "5")
+        self.run_cli("add", "fig", "1")
+        before = open(self.file).read()
+        self.assertEqual(self.run_cli("low-stock", "--below", "6"), (0, "fig\npear\n"))
+        self.assertEqual(open(self.file).read(), before)
+
 
 if __name__ == "__main__":
     unittest.main()
