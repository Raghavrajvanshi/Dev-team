+    def test_export_then_import_replace_round_trips(self):
+        self.run_cli("add", "pear", "3")
+        self.run_cli("add", "fig", "4")
+        out = os.path.join(self.dir, "out.csv")
+        self.run_cli("export", out)
+        self.run_cli("add", "kiwi", "9")
+        self.assertEqual(self.run_cli("import", out, "--replace"), (0, ""))
+        self.assertEqual(self.run_cli("total"), (0, "7\n"))
+
+    def test_import_merges_and_a_bad_file_changes_nothing(self):
+        self.run_cli("add", "pear", "3")
+        good = os.path.join(self.dir, "good.csv")
+        open(good, "w").write("name,qty\npear,2\nfig,1\n")
+        self.assertEqual(self.run_cli("import", good), (0, ""))
+        self.assertEqual(self.run_cli("total"), (0, "6\n"))
+        bad = os.path.join(self.dir, "bad.csv")
+        open(bad, "w").write("name,qty\npear,x\n")
+        before = open(self.file).read()
+        self.assertEqual(self.run_cli("import", bad)[0], 1)
+        self.assertEqual(open(self.file).read(), before)
+
 
 if __name__ == "__main__":
     unittest.main()
