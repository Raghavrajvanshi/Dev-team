diff --git a/csvio.py b/csvio.py
new file mode 100644
index 0000000..b35708e
--- /dev/null
+++ b/csvio.py
@@ -0,0 +1,35 @@
+"""CSV import and export of a stock ledger (name,qty rows under a header)."""
+import csv
+
+
+def export_rows(stock):
+    """Header plus one row per item, alphabetical."""
+    return [["name", "qty"]] + [[n, str(stock[n])] for n in sorted(stock)]
+
+
+def parse_rows(rows):
+    """Rows after the header as (name, qty) pairs; ValueError names every bad line."""
+    pairs, bad = [], []
+    for lineno, row in enumerate(rows, start=2):
+        try:
+            name, qty = row[0].strip(), int(row[1])
+            if not name or qty < 0:
+                raise ValueError
+        except (IndexError, ValueError):
+            bad.append(lineno)
+            continue
+        pairs.append((name, qty))
+    if bad:
+        raise ValueError("bad rows on line(s): " + ", ".join(map(str, bad)))
+    return pairs
+
+
+def read_file(path):
+    with open(path, newline="") as f:
+        rows = list(csv.reader(f))
+    return parse_rows(rows[1:])
+
+
+def write_file(path, stock):
+    with open(path, "w", newline="") as f:
+        csv.writer(f).writerows(export_rows(stock))
