+++ b/tests/test_csvio.py
@@ -0,0 +1,17 @@
+import unittest
+
+import csvio
+
+
+class Csvio(unittest.TestCase):
+    def test_export_is_alphabetical_with_header(self):
+        self.assertEqual(csvio.export_rows({"pear": 2, "apple": 5}), [["name", "qty"], ["apple", "5"], ["pear", "2"]])
+
+    def test_bad_rows_are_all_named(self):
+        with self.assertRaises(ValueError) as cm:
+            csvio.parse_rows([["pear", "x"], ["fig", "3"], ["kiwi", "-1"]])
+        self.assertIn("2, 4", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
