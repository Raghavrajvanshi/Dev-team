{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "guard"], "timeout": 10, "onFailure": "block" } ] },
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "state-protect"], "timeout": 10 } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "git-guard"], "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "route"], "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "finish-gate"], "timeout": 900 },
        { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "ledger"], "timeout": 10 }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "turn-count"], "timeout": 10 },
        { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "ledger"], "timeout": 10 }
      ] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh", "compact-reinject"], "timeout": 10 } ] }
    ]
  }
}
