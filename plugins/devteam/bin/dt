#!/usr/bin/env perl
# dt: the deterministic side of devteam. Skills call it; it owns state, criteria, gates and the close gate.
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use JSON::PP;
use File::Path qw(make_path);
use DT qw(root ddir slurp spit jread jwrite ts true false default_state default_config state_read state_write
  config_read config_write goal_dir seal check_seal sha_file git_out tree_key run_cmd ledger_add
  locked update_state run_gates);
use DT::Sessions qw(live_others holder_status lease_write foreign_writes ack acked probe transcript_file);
use DT::Scope ();

my $MIN_CLAUDE = '2.1.295';
my @NOISE = (':!.devteam', ':!.claude/worktrees', ':!.claude/settings.local.json');   # never make the tree "dirty"
my $PLUGIN = "$FindBin::Bin/..";
my %NEXT = (
    IDLE => [qw(INTAKE ONBOARDING STOPPED)], ONBOARDING => [qw(IDLE STOPPED)],
    INTAKE => [qw(ACTIVE PAUSED IDLE STOPPED)], ACTIVE => [qw(PAUSED BLOCKED VERIFYING STOPPED)],
    PAUSED => [qw(ACTIVE STOPPED)], BLOCKED => [qw(ACTIVE PAUSED STOPPED)],
    VERIFYING => [qw(ACTIVE BLOCKED ACHIEVED STOPPED)], ACHIEVED => [qw(IDLE)], STOPPED => [qw(IDLE)],
);
my @MODELS = qw(opus sonnet haiku inherit);
my @EFFORTS = qw(low medium high xhigh max);
# Checks that no hook can observe by itself; they are recorded with `dt trace note` (see skills/selftest).
my @MANUAL = (['skills-preload', 'plugin skills preloaded into an agent by bare name'], ['model-override', 'the model passed on spawn is the model the agent runs as'],
    ['state-protect-live', 'a subagent write to protected state is denied'], ['git-guard-live', 'a subagent push is denied'],
    ['dt-on-path', 'dt resolves from the plugin bin/ directory'], ['dt-authority-live', 'a subagent running dt close is denied'],
    ['sessions-registry', "Claude Code's session registry lists the running session"], ['security-engineer-live', 'the Security Engineer has no write tools and cannot commit'], ['deploy-guard-live', 'a subagent running terraform apply is denied'], ['guard-live', 'the spawn guard refuses an untyped agent and a worktree spawn without a grant'], ['pm-mode', 'claude --agent devteam:project-manager works as the PM']);
my %CMD = (
    init => \&c_init, gitignore => \&c_gitignore, preflight => \&c_preflight, state => \&c_state,
    engage => \&c_engage, disengage => \&c_disengage, goal => \&c_goal, criteria => \&c_criteria,
    verify => \&c_verify, gate => \&c_gate, close => \&c_close, lifecycle => \&c_lifecycle,
    models => \&c_models, grant => \&c_grant, branch => \&c_branch, status => \&c_status,
    resync => \&c_resync, ledger => \&c_ledger, queue => \&c_queue,
    team => \&c_team, who => \&c_who, shot => \&c_shot, knowledge => \&c_knowledge, trace => \&c_trace,
    sessions => \&c_sessions, scope => \&c_scope, risk => \&c_risk,
);

my $cmd = shift @ARGV // '';
if (!$CMD{$cmd}) { print STDERR "usage: dt <" . join('|', sort keys %CMD) . "> ...\n"; exit 2 }
our $EXIT = 0;
my %LOCKED = map { $_ => 1 } qw(state engage disengage goal grant branch resync criteria models queue);
eval { $LOCKED{$cmd} ? locked(sub { $CMD{$cmd}->(@ARGV) }) : $CMD{$cmd}->(@ARGV); 1 } or do { print STDERR $@; exit 1 };
exit $EXIT;

sub opts {
    my (%o, @p);
    while (@_) {
        my $a = shift;
        if ($a =~ /^--([\w-]+)=(.*)$/s) { $o{$1} = $2 }
        elsif ($a =~ /^--([\w-]+)$/) { my $k = $1; $o{$k} = (@_ && $_[0] !~ /^--/) ? shift : 1 }    # $k first: the inner match resets $1
        else { push @p, $a }
    }
    return (\%o, \@p);
}
sub need_init { -f ddir() . '/state.json' or die "dt: not initialised, run: dt init\n" }
sub goal_file { my ($n) = @_; my $g = goal_dir() or die "dt: no active goal\n"; "$g/$n" }
sub vcmp { my @a = split /\./, shift; my @b = split /\./, shift; for (0 .. 2) { my $d = ($a[$_] // 0) <=> ($b[$_] // 0); return $d if $d } 0 }
sub lifecycle_dirs { (ddir() . '/lifecycles', "$PLUGIN/lifecycles") }
sub lifecycle_names {
    my %n;
    for my $d (lifecycle_dirs()) { for my $f (glob "$d/*.md") { (my $b = $f) =~ s{.*/|\.md$}{}g; $n{$b} = 1 unless $b =~ /^_/ } }
    return sort keys %n;
}

# The extra done-checks a lifecycle adds to every goal run under it: lines "- cmd: TEXT :: COMMAND",
# "- judgement: TEXT" and "- manual: TEXT" under "## Extra done-checks" in its profile ({dt} and {goaldir} are
# filled in). The tiny lane runs no agents, so there a judgement check becomes manual: the user judges it.
sub lifecycle_checks {
    my ($name, $lane) = @_;
    my ($file) = grep { -f } map { "$_/$name.md" } lifecycle_dirs();
    return unless $file;
    my ($sec) = (slurp($file) // '') =~ /^## Extra done-checks[^\n]*\n(.*?)(?=^## |\z)/ms;
    return unless defined $sec;
    (my $gd = goal_dir() // '') =~ s{^\Q@{[ root() ]}\E/}{};
    my @out;
    for my $l (split /\n/, $sec) {
        my ($type, $rest) = $l =~ /^\s*-\s*(cmd|judgement|manual):\s*(\S.*?)\s*$/ or next;
        my ($text, $cmd) = $type eq 'cmd' ? split(/\s+::\s+/, $rest, 2) : ($rest, '');
        next unless length($text // '') && ($type ne 'cmd' || length($cmd // ''));
        $type = 'manual' if $type eq 'judgement' && ($lane // '') eq 'tiny';
        if ($type eq 'cmd') { $cmd =~ s/\{dt\}/'$FindBin::Bin\/dt'/g; $cmd =~ s/\{goaldir\}/$gd/g }
        push @out, { type => $type, text => $text, check => $cmd // '' };
    }
    return @out;
}

# Bring the goal's criteria in line with a lifecycle: open checks of another lifecycle go, this one's are added
# (ids L1, L2, ...). Checks that already pass are kept. Returns the added and removed criteria ids.
sub sync_lifecycle_checks {
    my ($name, $lane) = @_;
    my $f = goal_file('criteria.json');
    my $c = jread($f) or return ([], []);
    my (@added, @removed);
    my %mine = map { $_->{text} => 1 } grep { ($_->{lifecycle} // '') eq $name } @{ $c->{criteria} };
    @{ $c->{criteria} } = grep {
        my $drop = $_->{lifecycle} && $_->{lifecycle} ne $name && !$_->{passes};
        push @removed, $_->{id} if $drop;
        !$drop;
    } @{ $c->{criteria} };
    my %used = map { $_->{id} => 1 } @{ $c->{criteria} };
    my $n = 0;
    for my $w (lifecycle_checks($name, $lane)) {
        next if $mine{ $w->{text} };
        $n++ while $used{ 'L' . ($n + 1) };
        my $id = 'L' . ++$n;
        $used{$id} = 1;
        push @{ $c->{criteria} }, { id => $id, %$w, passes => false, evidence => undef, lifecycle => $name };
        push @added, $id;
    }
    if (@added || @removed) { jwrite($f, $c); seal() }
    return (\@added, \@removed);
}

# The people behind the role ids. Titles are fixed (team.tsv). Names are drawn at random from names.txt
# when the team is first needed, kept in .devteam/team.json until the team is stood down, and never
# repeat within a team. Role ids stay the technical key for hooks, config and spawning.
sub team_roles {
    open my $h, '<', "$PLUGIN/team.tsv" or die "dt: team.tsv missing\n";
    my @r;
    while (my $line = <$h>) {
        chomp $line;
        next if $line =~ /^#/ || $line !~ /\S/;
        my ($role, $title, $where) = split /\t/, $line;
        push @r, { role => $role, title => $title, shipped => ($where eq 'main' || -f "$PLUGIN/agents/$role.md") ? 1 : 0 };
    }
    return @r;
}
sub name_pool {
    my (%p, $sec);
    open my $h, '<', "$PLUGIN/names.txt" or die "dt: names.txt missing\n";
    while (my $line = <$h>) {
        chomp $line;
        next if $line =~ /^#/ || $line !~ /\S/;
        if ($line =~ /^\[(first|last)\]$/) { $sec = $1; next }
        push @{ $p{$sec} }, $line if $sec;
    }
    return @p{qw(first last)};
}
sub assign_names {
    my ($reroll) = @_;
    my $f = ddir() . '/team.json';
    my $have = $reroll ? {} : (jread($f) // {});
    my @missing = grep { !$have->{$_} } map { $_->{role} } team_roles();
    return $have unless @missing;
    my ($first, $last) = name_pool();
    my %used_f = map { ((split ' ', $_)[0] => 1) } values %$have;
    my %used_l = map { ((split ' ', $_)[1] => 1) } values %$have;
    srand($ENV{DT_SEED}) if defined $ENV{DT_SEED};
    for my $role (@missing) {
        my @f = grep { !$used_f{$_} } @$first;
        my @l = grep { !$used_l{$_} } @$last;
        my ($fn, $ln) = ($f[rand @f], $l[rand @l]);
        $used_f{$fn} = $used_l{$ln} = 1;
        $have->{$role} = "$fn $ln";
    }
    jwrite($f, $have);
    return $have;
}
sub team_rows {
    my ($all) = @_;
    my $names = assign_names();
    return map { { %$_, name => $names->{ $_->{role} } } } grep { $all || $_->{shipped} } team_roles();
}
sub find_person {
    my ($q) = @_;
    $q = lc($q // '');
    my @hit = grep { $q eq lc $_->{role} || $q eq lc $_->{name} || $q eq lc((split ' ', $_->{name})[0]) } team_rows(1);
    return @hit == 1 ? $hit[0] : undef;
}
sub member_role { my $p = find_person($_[0]); $p ? $p->{role} : $_[0] }
sub person_name { my $p = find_person($_[0]); $p ? $p->{name} : '' }

sub c_team {
    need_init();
    my ($o) = opts(@_);
    assign_names(1) if $o->{reroll};
    printf "%-22s %-22s %s\n", $_->{name}, $_->{title}, $_->{role} . ($_->{shipped} ? '' : ' (planned)') for team_rows($o->{all});
}
sub c_who {
    need_init();
    my ($o, $p) = opts(@_);
    my $x = find_person($p->[0]) or die "dt: no team member '" . ($p->[0] // '') . "' (try: dt team --all)\n";
    print $o->{role} ? "$x->{role}\n" : "$x->{name}, $x->{title}\n";
}

# Run an argv list (no shell) with a timeout; returns the exit code.
sub run_argv {
    my ($timeout, @argv) = @_;
    my $pid = fork() // die "fork: $!\n";
    if (!$pid) { open STDOUT, '>', '/dev/null'; open STDERR, '>&', \*STDOUT; exec @argv or exit 127 }
    my $to = 0;
    eval { local $SIG{ALRM} = sub { $to = 1; kill 'KILL', $pid; die "timeout\n" }; alarm $timeout; waitpid($pid, 0); alarm 0 };
    waitpid($pid, 0) if $to;
    return $to ? 124 : $? >> 8;
}

sub find_chrome {
    return $ENV{DT_CHROME} if $ENV{DT_CHROME} && -x $ENV{DT_CHROME};
    for my $p ('/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', '/Applications/Chromium.app/Contents/MacOS/Chromium') { return $p if -x $p }
    for my $n (qw(google-chrome google-chrome-stable chromium chromium-browser chrome)) {
        for my $d (split /:/, $ENV{PATH} // '') { return "$d/$n" if -x "$d/$n" }
    }
    return;
}

# dt shot [--serve DIR] [--widths 390,1280] [--height N] [--name NAME] <url | path under DIR>
# Headless-Chrome screenshots, so agents can look at what they built instead of only testing it.
sub c_shot {
    my ($o, $p) = opts(@_);
    my $target = $p->[0] // die "dt shot [--serve DIR] [--widths 390,768,1280] [--height N] [--name NAME] <url or path>\n";
    my $chrome = find_chrome() or die "dt: no Chrome/Chromium found (set DT_CHROME to its path)\n";
    my @widths = grep { /^\d+$/ } split /,/, ($o->{widths} // 1280);
    my $height = ($o->{height} // 2400) =~ /^(\d+)$/ ? $1 : 2400;
    my ($name) = ($o->{name} // $target) =~ /([\w.-]+)\/?$/;
    $name =~ s/\.html?$//;
    my $dir = (goal_dir() ? goal_dir() . '/evidence/shots' : ddir() . '/shots');
    make_path($dir);
    my ($url, $srv) = ($target);
    if (defined $o->{serve} && $o->{serve} ne '1') {
        die "dt: --serve needs python3\n" unless grep { -x "$_/python3" } split /:/, $ENV{PATH};
        my $port = 20000 + int(rand(20000));
        $srv = fork() // die "fork: $!\n";
        if (!$srv) { open STDOUT, '>', '/dev/null'; open STDERR, '>&', \*STDOUT; exec 'python3', '-m', 'http.server', $port, '--bind', '127.0.0.1', '--directory', $o->{serve} or exit 127 }
        require IO::Socket::INET;
        for (1 .. 30) { last if IO::Socket::INET->new(PeerAddr => '127.0.0.1', PeerPort => $port, Timeout => 1); select undef, undef, undef, 0.1 }
        (my $path = $target) =~ s{^/}{};
        $url = "http://127.0.0.1:$port/$path";
    }
    my @out;
    for my $w (@widths) {
        my $f = "$dir/$name-$w.png";
        my $rc = run_argv(60, $chrome, '--headless=new', '--disable-gpu', '--hide-scrollbars', "--window-size=$w,$height",
            '--virtual-time-budget=5000', "--screenshot=$f", $url);
        push @out, (-s $f ? $f : "FAILED ($rc) $f");
    }
    if ($srv) { kill 'TERM', $srv; waitpid($srv, 0) }
    print "$_\n" for @out;
    $EXIT = 1 if grep { /^FAILED/ } @out;
}

# dt knowledge [--stale DAYS]: cached research topics and how old they are.
sub c_knowledge {
    my ($o) = opts(@_);
    need_init();
    my @rows = map { [ (/([^\/]+)\.md$/)[0], int((time - (stat $_)[9]) / 86400), $_ ] } glob ddir() . '/knowledge/*.md';
    @rows = grep { $_->[1] >= $o->{stale} } @rows if defined $o->{stale};
    return print "no cached knowledge\n" unless @rows;
    printf "%-28s %4d days  %s\n", @$_ for sort { $a->[0] cmp $b->[0] } @rows;
}

sub trace_report {
    my ($recs) = @_;
    my @inp = grep { ref $_->{input} } @$recs;
    my $by = sub { my $h = shift; grep { ($_->{handler} // '') eq $h } @inp };
    my @row;
    my $add = sub { push @row, [@_] };
    my $list = sub { join ', ', sort keys %{ { map { $_ => 1 } @_ } } };

    my @spawn = $by->('guard');
    my %k;
    $k{$_}++ for map { keys %{ $_->{input}{tool_input} // {} } } @spawn;
    $add->(@spawn ? ($k{subagent_type} ? 'confirmed' : 'refuted') : 'unseen', 'agent-input-fields',
        @spawn ? 'Agent tool input fields seen: ' . join(', ', sort keys %k) : 'no spawn was observed');

    my @tool = ($by->('state-protect'), $by->('git-guard'));
    my @with_id = grep { length($_->{input}{agent_id} // '') } @tool;
    $add->(@with_id ? 'confirmed' : (@spawn && @tool ? 'suspect' : 'unseen'), 'agent-id-on-subagent-calls',
        @with_id ? scalar(@with_id) . " subagent tool call(s) carried agent_id" :
        (@spawn && @tool ? 'agents were spawned and tools ran, but none carried agent_id (or no subagent used a tool)' : 'no subagent tool call was observed'));

    my @types = grep { length } map { $_->{input}{agent_type} // '' } grep { $_->{agent} } @inp;
    my @bare = grep { !/^devteam:/ } @types;
    $add->(!@types ? 'unseen' : (@bare ? 'refuted' : 'confirmed'), 'agent-type-values',
        !@types ? 'no subagent event carried agent_type' : 'values seen: ' . $list->(@types) . (@bare ? ' (the role matrix expects the devteam: prefix)' : ''));

    my @stop = grep { ($_->{event} // '') eq 'SubagentStop' } @inp;
    my %sk;
    $sk{$_}++ for map { keys %{ $_->{input} } } @stop;
    $add->(@stop ? 'info' : 'unseen', 'subagent-stop-fields', @stop ? 'fields: ' . join(', ', sort keys %sk) : 'no SubagentStop was observed');

    my @start = grep { ($_->{event} // '') eq 'SubagentStart' } @inp;
    my %tk;
    $tk{$_}++ for map { keys %{ $_->{input} } } @start;
    $add->(@start ? 'info' : 'unseen', 'subagent-start-fields', @start ? 'fields: ' . join(', ', sort keys %tk) : 'no SubagentStart was observed');

    my @ag = grep { $_->{agent} } @inp;
    my $same = grep { $_->{owned} } @ag;
    $add->(@ag ? 'info' : 'unseen', 'subagent-session-id', @ag ? ($same == @ag ? 'subagent events carry the owning session id' : 'subagent events carry a different session id than the owner (agent events are still governed)') : 'no subagent event was observed');

    my @other = grep { !$_->{agent} && !$_->{owned} } @inp;
    $add->(@other ? 'confirmed' : 'unseen', 'other-session-events',
        @other ? scalar(@other) . ' hook event(s) from a session that does not own the team reached our hooks' : 'no event from another session was observed (needs a second session in the repo)');

    my @mo = grep { defined $_->{input}{tool_input}{model} || defined $_->{input}{tool_input}{effort} } @spawn;
    $add->(@mo ? 'info' : 'unseen', 'model-effort-passed',
        @mo ? 'passed on spawn: ' . join('; ', map { ($_->{input}{tool_input}{subagent_type} // '?') . ' model=' . ($_->{input}{tool_input}{model} // '-') . ' effort=' . ($_->{input}{tool_input}{effort} // '-') } @mo) : 'no spawn passed model or effort');

    my @comp = grep { ($_->{event} // '') eq 'SessionStart' } @inp;
    my %src;
    $src{ $_->{input}{source} // '?' }++ for @comp;
    $add->(%src ? ($src{compact} ? 'confirmed' : 'info') : 'unseen', 'session-start-sources', %src ? 'sources seen: ' . join(', ', sort keys %src) : 'no SessionStart was observed');

    # A block is honoured when the same agent stops again afterwards (it carried on instead of finishing).
    my (%stops, %blocks, $cur);
    for my $r (@$recs) {
        if (($r->{handler} // '') eq 'finish-gate' && ($r->{event} // '') eq 'SubagentStop') { $cur = $r->{input}{agent_id} // '?'; $stops{$cur}++ }
        elsif (ref $r->{decision} eq 'HASH' && ($r->{decision}{exit} // 0) == 2 && defined $cur) { $blocks{$cur}++ }
    }
    my $nblock = 0;
    $nblock += $_ for values %blocks;
    my @honoured = grep { $stops{$_} > $blocks{$_} } keys %blocks;
    $add->(!$nblock ? 'unseen' : (@honoured ? 'confirmed' : 'info'), 'finish-gate-blocked',
        !$nblock ? 'the finish gate never blocked'
        : "$nblock finish-gate block(s) issued" . (@honoured ? ', and the agent stopped again afterwards, so the block was honoured' : ' (no later stop from the same agent was seen, so it is not known to be honoured)'));

    my @pr = grep { ($_->{event} // '') eq 'UserPromptSubmit' } @inp;
    my @odd = grep { ($_->{input}{prompt} // '') =~ /<(?:task-notification|cross-session|system-reminder)/ } @pr;
    $add->(@pr ? 'info' : 'unseen', 'prompt-submit-turns', @pr ? scalar(@pr) . ' prompt event(s), ' . scalar(@odd) . ' look like non-user turns' : 'no UserPromptSubmit was observed');

    my ($tot, $withtok) = (0, 0);
    if (open my $lh, '<', ddir() . '/log.jsonl') {
        while (my $l = <$lh>) { my $r = eval { decode_json($l) } or next; next unless ($r->{event} // '') eq 'subagent_stop'; $tot++; $withtok++ if $r->{tokens} }
    }
    $add->($tot ? ($withtok ? 'confirmed' : 'refuted') : 'unseen', 'subagent-token-usage',
        $tot ? "$withtok of $tot subagent stops had token usage in the ledger" : 'no subagent stop reached the ledger');

    my %note;
    for my $r (grep { ($_->{kind} // '') eq 'note' } @$recs) { $note{ $r->{id} } = $r }
    for my $m (@MANUAL) {
        my $n = $note{ $m->[0] };
        $add->($n ? $n->{verdict} : 'unseen', $m->[0], $n ? "$m->[1]: " . ($n->{text} || '(no evidence given)') : "$m->[1]: no note recorded (run the selftest)");
    }
    printf "%-10s %-28s %s\n", @$_ for @row;
    my %c;
    $c{ $_->[0] }++ for @row;
    print "\n" . join(', ', map { "$_ $c{$_}" } sort keys %c) . "\n";
}

# dt trace on|off|status|show [--tail N]|clear|note ID confirmed|refuted|unseen [evidence...]|report
sub c_trace {
    my ($sub, @a) = @_;
    need_init();
    $sub //= 'status';
    my $f = ddir() . '/trace.jsonl';
    if ($sub eq 'on' || $sub eq 'off') {
        my $c = config_read();
        $c->{trace} = $sub eq 'on' ? true : false;
        config_write($c);
        return print "trace $sub (records go to .devteam/trace.jsonl; they may hold fragments of prompts and commands)\n";
    }
    if ($sub eq 'clear') { unlink $f; return print "trace cleared\n" }
    if ($sub eq 'note') {
        my ($id, $verdict, @t) = @a;
        die "dt trace note ID confirmed|refuted|unseen [evidence...]\n" unless length($id // '') && ($verdict // '') =~ /^(?:confirmed|refuted|unseen)$/;
        open my $h, '>>', $f or die "dt: cannot write the trace: $!\n";
        print $h JSON::PP->new->canonical->encode({ ts => ts(), kind => 'note', id => $id, verdict => $verdict, text => join(' ', @t) }), "\n";
        close $h;
        return print "noted $id: $verdict\n";
    }
    my @recs = map { eval { decode_json($_) } || () } split /\n/, (slurp($f) // '');
    if ($sub eq 'status') { return printf "trace: %s, %d record(s)\n", (config_read()->{trace} ? 'on' : 'off'), scalar @recs }
    if ($sub eq 'show') {
        my ($o) = opts(@a);
        my $n = ($o->{tail} // 40) =~ /^(\d+)$/ ? $1 : 40;
        my @t = @recs > $n ? @recs[-$n .. -1] : @recs;
        for my $r (@t) {
            if (($r->{kind} // '') eq 'note') { print "$r->{ts} note $r->{id}: $r->{verdict} $r->{text}\n" }
            elsif (exists $r->{decision}) { my $d = ref $r->{decision} ? encode_json($r->{decision}) : $r->{decision}; print "$r->{ts} $r->{handler} -> " . substr($d, 0, 110) . "\n" }
            else { printf "%s %-16s %-17s agent=%d owned=%d keys=%s\n", $r->{ts}, $r->{handler}, $r->{event} // '', $r->{agent} // 0, $r->{owned} // 0, join(',', sort keys %{ $r->{input} // {} }) }
        }
        return;
    }
    return trace_report(\@recs) if $sub eq 'report';
    die "dt trace: on|off|status|show [--tail N]|clear|note ID VERDICT [evidence]|report\n";
}

sub c_init {
    my $d = ddir();
    make_path("$d/$_") for qw(goals adr discussions reports);
    jwrite("$d/config.json", default_config()) unless -f "$d/config.json";
    jwrite("$d/state.json", default_state()) unless -f "$d/state.json";
    seal();
    print "initialised $d\n";
}

sub c_gitignore {
    my $root = root();
    my $f = git_out($root, 'rev-parse', '--git-path', 'info/exclude');
    die "dt: not a git repository\n" unless length $f;
    $f = "$root/$f" unless $f =~ m{^/};
    my $c = slurp($f) // '';
    my @add = grep { $c !~ /^\Q$_\E\s*$/m } ('.devteam/', '.claude/worktrees/', '.claude/settings.local.json');
    return print "already ignored locally (.git/info/exclude)\n" unless @add;
    spit($f, $c . ($c =~ /\n\z|^\z/ ? '' : "\n") . join('', map {"$_\n"} @add));
    print "ignored locally via .git/info/exclude (your .gitignore is untouched): " . join(', ', @add) . "\n";
}

sub c_preflight {
    my $root = root();
    my ($bad, @out) = (0);
    my $add = sub { my ($ok, $n, $d) = @_; $bad++ if $ok eq 'FAIL'; push @out, sprintf('%-4s %s: %s', $ok, $n, $d) };
    my $v = $ENV{DT_CLAUDE_VERSION} // (`claude --version 2>/dev/null` =~ /(\d+\.\d+\.\d+)/ ? $1 : '');
    $v ? ($add->(vcmp($v, $MIN_CLAUDE) >= 0 ? 'ok' : 'FAIL', 'claude-version', "$v (need >= $MIN_CLAUDE)")) : $add->('FAIL', 'claude-version', 'claude not found');
    my $head = git_out($root, 'rev-parse', '--verify', '-q', 'HEAD');
    $add->($head ? 'ok' : 'FAIL', 'git', $head ? 'repository with at least one commit' : 'not a git repository with a commit (offer: git init + initial commit)');
    my $dirty = $head ? git_out($root, 'status', '--porcelain', '--', '.', @NOISE) : '';
    $add->($dirty eq '' ? 'ok' : 'FAIL', 'clean-tree', $dirty eq '' ? 'working tree clean' : 'uncommitted changes: ' . (split /\n/, $dirty)[0] . ' ...');
    for my $f ("$PLUGIN/bin/dt", "$PLUGIN/hooks/hook.sh") {
        $add->(-x $f ? 'ok' : 'FAIL', 'executable', $f =~ s{.*/}{}r . (-x $f ? '' : ' missing or not executable'));
    }
    my $g = (config_read()->{gates} // {});
    $add->((grep { $g->{$_} } qw(test typecheck format)) ? 'ok' : 'warn', 'gates', (grep { $g->{$_} } qw(test typecheck format)) ? 'configured' : 'not configured: gates will report "not configured"');
    print "$_\n" for @out;
    $EXIT = 1 if $bad;
    return;
}

sub c_state {
    my ($sub, @a) = @_;
    need_init();
    my $s = state_read();
    $sub //= 'show';
    if ($sub eq 'show') { print JSON::PP->new->canonical->pretty->encode($s); return }
    if ($sub eq 'get') { my $v = $s->{ $a[0] // '' }; print ref $v ? encode_json($v) : ($v // ''), "\n"; return }
    if ($sub eq 'set') {
        for my $kv (@a) {
            my ($k, $v) = split /=/, $kv, 2;
            die "dt: unknown or protected state key '$k'\n" unless defined $v && exists default_state()->{$k} && $k !~ /^(?:status|engaged|owner_session|retries|git_grants|queue|outcome)$/;
            $s->{$k} = $k =~ /^(?:spawns|spawn_cap|main_turns|turn_cap|returns|ledger_offset)$/ ? $v + 0 : $k eq 'adhoc' ? ($v =~ /^(?:1|true|yes)$/ ? true : false) : $v;
        }
        return state_write($s);
    }
    if ($sub eq 'transition') { my ($to, @why) = @a; return transition($s, $to, join(' ', @why)) }
    die "dt state: show|get K|set K=V...|transition STATUS [reason]\n";
}

sub transition {
    my ($s, $to, $why) = @_;
    my $from = $s->{status};
    die "dt: unknown status '$to'\n" unless $NEXT{ $to // '' };
    die "dt: ACHIEVED is reached only through 'dt close'\n" if $to eq 'ACHIEVED';
    die "dt: BLOCKED needs a reason\n" if $to eq 'BLOCKED' && !length $why;
    die "dt: illegal transition $from -> $to\n" unless $to eq 'STOPPED' || grep { $_ eq $to } @{ $NEXT{$from} };
    if ($to eq 'STOPPED' && $from =~ /^(?:ACTIVE|PAUSED|BLOCKED|VERIFYING)$/ && length $s->{goal}) {
        # A goal that was confirmed and then ended without closing still gets an honest outcome.
        my ($result, $because) = $from eq 'BLOCKED'
            ? ('blocked', "stopped while blocked: $s->{blocked_reason}") : ('failed', "stopped before it was closed (was $from)");
        # Stopping is always honoured: a report that cannot be written is noted, never a reason to refuse.
        $s->{outcome} = eval { end_goal($s, $result, $because) }
            // { result => $result, why => "$because (closure report not written: " . ($@ =~ s/\s+\z//r) . ')', pass => 0, total => 0, open => [], ts => ts() };
    }
    $s->{status} = $to;
    $s->{blocked_reason} = $to eq 'BLOCKED' ? $why : '';
    $s->{adhoc} = false;
    state_write($s);
    ledger_add({ event => 'transition', from => $from, to => $to, why => $why });
    print "$from -> $to\n";
}

# dt engage <session> [--take-over] [--accept-others]: exit 2 (nothing changed) when another session still holds the
# team or other live sessions share this working tree; the user decides, then it is re-run with the flag.
sub c_engage {
    my ($o, $p) = opts(@_);
    my ($sid) = @$p;
    die "usage: dt engage <session_id> [--take-over] [--accept-others]\n" unless $sid;
    c_init() unless -f ddir() . '/state.json';
    my @why;
    my $result = locked(sub {    # one decision at a time: two sessions starting together cannot both win
        my $s = state_read();
        my $holder = $s->{engaged} ? ($s->{owner_session} // '') : '';
        my $held = length $holder && $holder ne $sid ? holder_status($holder, $sid) : undef;
        if ($held && $held->{live} && !$o->{'take-over'}) {
            push @why, 'another session holds the team: ' . substr($holder, 0, 8) . " ($held->{why}). Take it over only if that is a window of yours you are done with: dt engage $sid --take-over";
        }
        my @others = grep { !($o->{'take-over'} && $_->{id} eq $holder) } live_others($sid);
        push @why, scalar(@others) . " other Claude session(s) may be writing in this working tree:\n" . join("\n", map { '  - ' . describe($_) } @others)
            . "\nFinish or stop them, work in a separate worktree, or continue alongside them: dt engage $sid --accept-others" if @others && !$o->{'accept-others'};
        return 0 if @why;
        @$s{qw(engaged owner_session)} = (true, $sid);
        state_write($s);
        lease_write($sid);
        # Cost accounting starts here: history already in this session's transcript is not the team's.
        my ($tf, $of) = (transcript_file($sid), ddir() . "/ledger.offset.main-$sid");
        spit($of, (-s $tf) . "\t\n") if -f $tf && !-f $of;
        ledger_add({ event => 'engage', session => $sid, took_over => $held && $held->{live} ? $holder : '', others => scalar @others });
        if ($held && !$held->{live}) { print 'note: ' . substr($holder, 0, 8) . " held the team earlier ($held->{why}); this session holds it now\n" }
        return 1;
    });
    if (!$result) { print "ENGAGE NEEDS A CHOICE (nothing changed):\n- " . join("\n- ", @why) . "\n"; $EXIT = 2; return }
    print "engaged for session $sid\n";
}
sub c_disengage {
    need_init();
    my $s = state_read();
    @$s{qw(engaged owner_session)} = (false, '');
    state_write($s);
    unlink ddir() . '/team.json', ddir() . '/session.lock';
    print "disengaged (the team is stood down; a new one is drawn next time)\n";
}

sub c_goal {
    my ($sub, @a) = @_;
    need_init();
    my $s = state_read();
    if (($sub // '') eq 'new') {
        die "dt: a goal can start only from IDLE (status is $s->{status})\n" unless $s->{status} eq 'IDLE';
        my $title = join ' ', @a;
        die "usage: dt goal new <title>\n" unless length $title;
        my ($max) = sort { $b <=> $a } map { /G-(\d+)$/ ? $1 : () } glob ddir() . '/goals/G-*';
        my $id = sprintf 'G-%03d', ($max // 0) + 1;
        my $dir = ddir() . "/goals/$id";
        make_path("$dir/evidence");
        my $t = slurp("$PLUGIN/templates/goal.md") // "# {{id}}: {{title}}\n";
        $t =~ s/\{\{id\}\}/$id/g;
        $t =~ s/\{\{title\}\}/$title/g;
        spit("$dir/goal.md", $t);
        spit("$dir/board.md", slurp("$PLUGIN/templates/board.md") // "# Board\n");
        jwrite("$dir/criteria.json", { criteria => [], locks => {} });
        @$s{qw(goal lane lifecycle spawns spawn_cap main_turns turn_cap returns)} = ($id, '', '', 0, 0, 0, 0, 0);
        @$s{qw(retries git_grants blocked_reason ledger_offset integration_branch original_branch original_sha outcome)} = ({}, {}, '', 0, '', '', '', {});
        $s->{status} = 'INTAKE';
        state_write($s);
        ledger_add({ event => 'goal_new', goal => $id, title => $title });
        return print "$id created (INTAKE): $dir/goal.md\n";
    }
    if (($sub // '') eq 'confirm') {
        my ($o) = opts(@a);
        die "dt: goal can be confirmed only from INTAKE\n" unless $s->{status} eq 'INTAKE';
        my $crit = jread(goal_file('criteria.json'));
        die "dt: a goal needs at least one done-criterion before it can be confirmed\n" unless @{ $crit->{criteria} };
        my $cfg = config_read();
        my $lane = $o->{lane} // die "dt goal confirm --lane tiny|standard|large --lifecycle NAME [--grants a,b]\n";
        my $lc = $o->{lifecycle} // die "dt goal confirm: --lifecycle required\n";
        die "dt: unknown lane '$lane'\n" unless $cfg->{lanes}{$lane};
        die "dt: unknown lifecycle '$lc' (have: " . join(', ', lifecycle_names()) . ")\n" unless grep { $_ eq $lc } lifecycle_names();
        my ($added) = sync_lifecycle_checks($lc, $lane);
        $s->{lane} = $lane;
        $s->{lifecycle} = $lc;
        $s->{spawn_cap} = $cfg->{lanes}{$lane}{spawn_cap};
        $s->{turn_cap} = $cfg->{lanes}{$lane}{turn_cap};
        $s->{git_grants} = { map { $_ => true } grep {length} split /,/, ($o->{grants} // '') };
        $s->{status} = 'ACTIVE';
        state_write($s);
        ledger_add({ event => 'goal_confirm', goal => $s->{goal}, lane => $lane, lifecycle => $lc, grants => [ sort keys %{ $s->{git_grants} } ] });
        print "$s->{goal} confirmed: lane=$lane lifecycle=$lc grants=" . join(',', sort keys %{ $s->{git_grants} }) . "\n";
        return print "the $lc lifecycle added done-checks: " . join(', ', @$added) . " (dt criteria show)\n" if @$added;
        return;
    }
    if (($sub // '') eq 'lane') {
        my $lane = $a[0] // '';
        my $cfg = config_read();
        die "dt goal lane tiny|standard|large\n" unless $cfg->{lanes}{$lane};
        die "dt: no goal to re-lane\n" unless length $s->{goal} && $s->{status} =~ /^(?:INTAKE|ACTIVE|PAUSED|BLOCKED)$/;
        @$s{qw(lane spawn_cap turn_cap)} = ($lane, $cfg->{lanes}{$lane}{spawn_cap}, $cfg->{lanes}{$lane}{turn_cap});
        state_write($s);
        ledger_add({ event => 'lane', goal => $s->{goal}, lane => $lane });
        return print "lane = $lane (spawn cap $s->{spawn_cap}, spawns used $s->{spawns})\n";
    }
    die "dt goal: new <title> | confirm --lane L --lifecycle N [--grants a,b] | lane L\n";
}

sub c_criteria {
    my ($sub, @a) = @_;
    need_init();
    my $f = goal_file('criteria.json');
    my $c = jread($f);
    my ($o, $p) = opts(@a);
    if ($sub eq 'add') {
        my $type = $o->{type} // 'cmd';
        die "dt criteria add --id C1 --text \"WHEN ... THEN ...\" [--type cmd|manual|judgement] [--check CMD]\n" unless $o->{id} && $o->{text};
        die "dt: type must be cmd, manual or judgement\n" unless $type =~ /^(?:cmd|manual|judgement)$/;
        die "dt: a cmd criterion needs --check\n" if $type eq 'cmd' && !$o->{check};
        die "dt: duplicate id $o->{id}\n" if grep { $_->{id} eq $o->{id} } @{ $c->{criteria} };
        push @{ $c->{criteria} }, { id => $o->{id}, text => $o->{text}, type => $type, check => $o->{check} // '', passes => false, evidence => undef };
        jwrite($f, $c);
        seal();
        return print "criterion $o->{id} added\n";
    }
    if ($sub eq 'remove') {
        my $n = @{ $c->{criteria} };
        @{ $c->{criteria} } = grep { $_->{id} ne ($p->[0] // '') } @{ $c->{criteria} };
        die "dt: unknown criterion '" . ($p->[0] // '') . "'\n" if @{ $c->{criteria} } == $n;
        jwrite($f, $c);
        seal();
        return print "$p->[0] removed\n";
    }
    if ($sub eq 'edit') {
        my ($cr) = grep { $_->{id} eq ($p->[0] // '') } @{ $c->{criteria} };
        die "dt: unknown criterion '" . ($p->[0] // '') . "'\n" unless $cr;
        $cr->{text} = $o->{text} if defined $o->{text};
        $cr->{check} = $o->{check} if defined $o->{check};
        @$cr{qw(passes evidence)} = (false, undef);
        jwrite($f, $c);
        seal();
        return print "$p->[0] edited (must be verified again)\n";
    }
    if ($sub eq 'lock') {
        for my $file (@$p) {
            die "dt: no such file $file\n" unless -f root() . "/$file";
            $c->{locks}{$file} = sha_file(root() . "/$file");
        }
        jwrite($f, $c);
        seal();
        return print "locked: " . join(', ', @$p) . "\n";
    }
    if ($sub eq 'confirm') {
        my ($id) = @$p;
        my ($cr) = grep { $_->{id} eq ($id // '') } @{ $c->{criteria} };
        die "dt: unknown criterion '" . ($id // '') . "'\n" unless $cr;
        die "dt: only manual or judgement criteria can be confirmed by hand\n" if $cr->{type} eq 'cmd';
        die "dt criteria confirm Cn --by user|verifier [--note TEXT]\n" unless ($o->{by} // '') =~ /^(?:user|verifier)$/;
        @$cr{qw(passes evidence)} = (true, { by => $o->{by}, note => $o->{note} // '', ts => ts() });
        jwrite($f, $c);
        seal();
        return print "$id confirmed by $o->{by}\n";
    }
    if (($sub // 'show') eq 'show') {
        printf "%-4s %-9s %-5s %s\n", $_->{id}, $_->{type}, ($_->{passes} ? 'PASS' : 'open'), $_->{text} for @{ $c->{criteria} };
        print "locked: $_\n" for sort keys %{ $c->{locks} };
        return;
    }
    die "dt criteria: add|edit|remove|lock|confirm|show\n";
}

sub verify_all {
    my ($quiet) = @_;
    my $f = goal_file('criteria.json');
    my $t = check_seal();
    die "dt: protected files changed outside dt: @$t (review them, then 'dt resync')\n" if @$t;   # re-sealing would accept them
    my $c = jread($f);
    my $root = root();
    my $key = tree_key($root);
    my $to = config_read()->{gates}{timeout} || 300;
    my (@viol, @pending);
    my $pass = 0;
    for my $file (sort keys %{ $c->{locks} }) { push @viol, $file if sha_file("$root/$file") ne $c->{locks}{$file} }
    for my $cr (@{ $c->{criteria} }) {
        if ($cr->{type} eq 'cmd') {
            my $ev = goal_file("evidence/crit-$cr->{id}-$key.json");
            my $r = jread($ev);
            if (!$r) {
                my ($ex, $tail) = run_cmd($cr->{check}, $root, $to);
                $r = { exit => $ex, tail => $tail, key => $key, ts => ts() };
                jwrite($ev, $r) if $ex == 0;
            }
            $cr->{passes} = $r->{exit} == 0 ? true : false;
            $cr->{evidence} = { exit => $r->{exit}, tree => $key, ts => $r->{ts} };
            print "FAIL $cr->{id}: $cr->{text}\n" . ($r->{tail} // '') . "\n" if $r->{exit} != 0 && !$quiet;
        }
        elsif (!$cr->{passes}) { push @pending, $cr->{id} }
        $pass++ if $cr->{passes};
    }
    jwrite($f, $c);
    seal();
    my $total = @{ $c->{criteria} };
    print "verify: $pass/$total pass" . (@pending ? "; awaiting confirmation: @pending" : '') . (@viol ? "; LOCK_VIOLATION: @viol" : '') . "\n" unless $quiet;
    my @open = map { $_->{id} } grep { !$_->{passes} } @{ $c->{criteria} };
    return { ok => (!@viol && !@open) ? 1 : 0, pass => $pass, total => $total, open => \@open, violations => \@viol };
}
sub c_verify { need_init(); $EXIT = verify_all()->{ok} ? 0 : 1; return }

sub c_gate {
    my ($sub, @a) = @_;
    need_init();
    if (($sub // '') eq 'set') {
        my $cfg = config_read();
        for my $kv (@a) {
            my ($k, $v) = split /=/, $kv, 2;
            die "dt gate set: use format|typecheck|test|test_affected|install|timeout=VALUE\n" unless defined $v && $k =~ /^(?:format|typecheck|test|test_affected|install|timeout)$/;
            $cfg->{gates}{$k} = $k eq 'timeout' ? $v + 0 : $v;
        }
        config_write($cfg);
        return print "gates updated\n";
    }
    die "dt gate run [--full] [--require] [--cwd DIR] | dt gate set KEY=VALUE...\n" unless ($sub // '') eq 'run';
    my ($o) = opts(@a);
    my ($ok, $msg) = run_gates($o->{cwd} // root(), $o->{full});
    if ($ok && $o->{require} && $msg eq 'gates not configured') {
        print "no gate is configured, so there is nothing to pass (dt gate set test=COMMAND)\n";
        $EXIT = 1;
        return;
    }
    print "$msg\n";
    $EXIT = 1 unless $ok;
    return;
}

# Who confirmed a manual or judgement criterion, and what they said, so the closure report keeps the owner's own words.
sub confirmed_by {
    my ($cr) = @_;
    my $e = $cr->{evidence};
    return '' unless $cr->{passes} && ref $e eq 'HASH' && length($e->{by} // '');
    return " (confirmed by $e->{by}" . (length($e->{note} // '') ? ": $e->{note}" : ', no note') . ')';
}

# Record how a goal ended: the closure report, the ledger entry and the outcome record kept in state.
# result is verified | partial | failed | blocked; the caller stores the returned record in state.
sub end_goal {
    my ($s, $result, $because, $gates, $security) = @_;
    my @all = @{ (jread(goal_file('criteria.json')) // {})->{criteria} // [] };
    my @open = map { $_->{id} } grep { !$_->{passes} } @all;
    my $pass = @all - @open;
    spit(goal_file('closure.md'),
        "# $s->{goal} closed " . ts() . "\noutcome: " . uc($result) . " ($pass of " . scalar(@all) . " criteria pass)\n"
      . "lane: $s->{lane}, lifecycle: $s->{lifecycle}, agents spawned: $s->{spawns}\n"
      . (defined $gates ? "gates: $gates\n" : '') . (length($security // '') ? "security: $security\n" : '') . "why: $because\n\n"
      . join('', map { "- $_->{id} " . ($_->{passes} ? 'PASS' : 'OPEN') . ": $_->{text}" . confirmed_by($_) . "\n" } @all));
    ledger_add({ event => 'goal_closed', goal => $s->{goal}, outcome => $result, spawns => $s->{spawns}, open => \@open });
    return { result => $result, why => $because, pass => $pass, total => scalar @all, open => \@open, ts => ts() };
}

# dt close: verified when every criterion passes. dt close --accept-partial --reason TEXT --by user: partial,
# only with the user's acceptance and never over a lock violation, tamper or a moved branch.
sub c_close {
    need_init();
    my ($o) = opts(@_);
    my $s = state_read();
    die "dt: close needs status VERIFYING (is $s->{status}); finish the work first\n" unless $s->{status} eq 'VERIFYING';
    my $partial = $o->{'accept-partial'} ? 1 : 0;
    my $tamper = check_seal();    # first: verify_all re-seals, so a second attempt must not see a clean seal
    if (@$tamper) { print "CLOSE REFUSED:\n- protected files changed outside dt: @$tamper (review, then 'dt resync')\n"; $EXIT = 1; return }
    my $v = verify_all(1);
    my @why;
    push @why, "locked acceptance tests were changed: @{ $v->{violations} }" if @{ $v->{violations} };
    if (my $sc = DT::Scope::load()) {
        my @out = DT::Scope::outside($sc);
        push @why, "writes outside the task's scope are unresolved: @out (dt scope check; the user keeps them with dt scope accept)" if @out;
    }
    if (length $s->{original_branch}) {
        my $now = git_out(root(), 'rev-parse', $s->{original_branch});
        push @why, "your branch '$s->{original_branch}' moved since the goal started" if $now ne $s->{original_sha};
    }
    if ($partial) {
        push @why, 'every criterion passes, so nothing is partial: use plain dt close' unless @{ $v->{open} };
        push @why, 'no criterion passes: that is a failed goal, not a partial one (stopping it records that)' unless $v->{pass};
    }
    else { push @why, "done-criteria not all verified: @{ $v->{open} } (run: dt verify)" if @{ $v->{open} } }
    my ($gok, $gmsg) = (1, '');
    ($gok, $gmsg) = run_gates(root(), 1) unless @why;
    push @why, $gmsg unless $gok || $partial;
    if (@why) { print "CLOSE REFUSED:\n- " . join("\n- ", @why) . "\n"; $EXIT = 1; return }
    my $gates = $gok ? $gmsg : 'FAILING, accepted with the goal: ' . (split /\n/, $gmsg)[0];
    if ($partial) {
        my $r = $o->{reason};
        unless (defined $r && $r =~ /\w/ && $r ne '1' && ($o->{by} // '') eq 'user') {
            my %text = map { $_->{id} => $_->{text} } @{ jread(goal_file('criteria.json'))->{criteria} };
            print "PARTIAL CLOSE NEEDS THE USER (nothing recorded). Accepting it leaves these done-criteria unmet:\n"
              . join('', map { "- $_: $text{$_}\n" } @{ $v->{open} }) . ($gok ? '' : "gates are failing too: $gates\n")
              . "Show the user this list. Only if they accept it, run:\n  dt close --accept-partial --reason \"<their reason, in their words>\" --by user\n";
            $EXIT = 1;
            return;
        }
    }
    # A change that trips security triggers (risk.tsv) and that no Security Engineer reviewed is the user's decision:
    # move up and have it reviewed, or accept it by name. A script decides, so the PM cannot skip the question.
    my $security = '';
    unless (security_ran($s->{goal})) {
        my ($hits) = risk_scan($s->{original_sha} || 'HEAD');
        if (@$hits) {
            my @top = @$hits[ 0 .. ($#$hits > 9 ? 9 : $#$hits) ];
            if ($o->{'accept-risk'} && ($o->{by} // '') eq 'user') {
                $security = 'no Security Engineer reviewed this goal and the user accepted its triggers: ' . join('; ', @top);
            } else {
                print "CLOSE NEEDS THE USER'S DECISION (nothing recorded). The change trips security triggers and no Security Engineer has reviewed it:\n"
                  . join('', map { "  $_\n" } @top)
                  . "Show the user this list. Either have it reviewed: dt state transition ACTIVE, dt goal lane standard (the tiny lane runs no agents),\n"
                  . "then the security pass; or, only if they accept the risk, run:\n  dt close --accept-risk --by user\n";
                $EXIT = 1;
                return;
            }
        }
    }
    my $rec = end_goal($s, $partial ? 'partial' : 'verified',
        $partial ? "accepted as partial by the user: $o->{reason}" : 'every criterion passes and the gates are green', $gates, $security);
    update_state(sub { $_[0]{status} = 'ACHIEVED' }) unless $partial;
    update_state(sub { @{ $_[0] }{qw(status outcome)} = ('IDLE', $rec) });
    print +($partial ? "$s->{goal} closed as PARTIAL (open: @{ $v->{open} }) -> IDLE" : "$s->{goal} ACHIEVED -> IDLE")
        . ". Closure report: " . goal_file('closure.md') . "\n";
}

sub c_lifecycle {
    my ($sub, @a) = @_;
    $sub //= 'list';
    if ($sub eq 'list') { print "$_\n" for lifecycle_names(); return }
    if ($sub eq 'set') {
        need_init();
        die "dt: unknown lifecycle '" . ($a[0] // '') . "'\n" unless grep { $_ eq ($a[0] // '') } lifecycle_names();
        my $s = state_read();
        $s->{lifecycle} = $a[0];
        state_write($s);
        print "lifecycle = $a[0]\n";
        if (length($s->{goal} // '') && $s->{status} =~ /^(?:INTAKE|ACTIVE|PAUSED|BLOCKED)$/) {
            my ($added, $removed) = locked(sub { sync_lifecycle_checks($a[0], $s->{lane}) });
            print "done-checks added: " . join(', ', @$added) . "\n" if @$added;
            print "done-checks removed (they were open and belonged to the previous lifecycle): " . join(', ', @$removed) . "\n" if @$removed;
        }
        return;
    }
    if ($sub eq 'checks') {
        my @c = lifecycle_checks($a[0] // '', 'standard');
        return print "none\n" unless @c;
        my $i = 0;
        print 'L' . ++$i . " $_->{type}: $_->{text}" . ($_->{check} ? " :: $_->{check}" : '') . "\n" for @c;
        return;
    }
    if ($sub eq 'suggest') {
        my ($o) = opts(@a);
        my %sig = (map { $_ => $o->{$_} // '*' } qw(requirements risk delivery ops size));
        my @col = qw(requirements risk delivery ops size);
        my (@hit, @fit);
        my %have = map { $_ => 1 } lifecycle_names();
        open my $h, '<', "$PLUGIN/lifecycles/_select.tsv" or die "dt: lifecycles/_select.tsv missing\n";
        while (my $line = <$h>) {
            chomp $line;
            next if $line =~ /^#/ || $line !~ /\S/;
            my ($id, @f) = split /\t/, $line;
            my $why = pop @f;
            my $m = 1;
            # a signal that was not given satisfies only a "*" cell: a row that asks for ops=yes is not met by silence
            for my $i (0 .. $#col) { $m &&= ($f[$i] eq '*' || ($sig{ $col[$i] } ne '*' && grep { $_ eq $sig{ $col[$i] } } split /\|/, $f[$i])) }
            push @fit, [ $id, $why ] if $m && !grep { $_->[0] eq $id } @fit;
        }
        close $h;
        @hit = grep { $have{$_->[0]} } @fit;
        print "note: $fit[0][0] fits best but is not installed in this release\n" if @fit && !$have{$fit[0][0]};
        @hit or push @hit, [ 'agile-kanban', 'default: minimal-ceremony continuous flow' ];
        print "recommended: $hit[0][0] | $hit[0][1]\n";
        print "runner-up: $hit[1][0] | $hit[1][1]\n" if $hit[1];
        print "all: " . join(', ', lifecycle_names()) . "\n";
        return;
    }
    die "dt lifecycle: list|set NAME|checks NAME|suggest --requirements stable|evolving|unclear --risk regulated|high|normal --delivery project|product|maintenance --ops yes|no --size tiny|standard|large\n";
}

sub c_models {
    my ($sub, @a) = @_;
    need_init();
    my $cfg = config_read();
    my $def = default_config()->{models};
    $sub //= 'show';
    my $row = sub { my ($m) = @_; my $x = $cfg->{models}{$m}; my $d = $def->{$m} // {}; ($x->{model}, $x->{effort}, ($x->{model} eq ($d->{model} // '') && $x->{effort} eq ($d->{effort} // '')) ? 'recommended' : 'custom') };
    if ($sub eq 'show') {
        printf "%-20s %-8s %-7s %-12s %s\n", $_, $row->($_), person_name($_) for sort keys %{ $cfg->{models} };
        return print "escalation: $cfg->{escalation}   chosen: " . ($cfg->{models_chosen} ? 'yes' : 'no (ask once)') . "\n";
    }
    if ($sub eq 'get') {
        my $m = member_role($a[0]);
        die "dt models get <member>\n" unless $cfg->{models}{ $m };
        my ($mo, $ef, $st) = $row->($m);
        return print "model=$mo effort=$ef changed=" . ($st eq 'custom' ? 'yes' : 'no') . "\n";
    }
    if ($sub eq 'set') {
        my ($o, $p) = opts(@a);
        my @members = map { member_role($_) } map { split /,/ } @$p;
        die "dt models set <member[,member]> [--model " . join('|', @MODELS, 'recommended') . "] [--effort " . join('|', @EFFORTS, 'recommended') . "]\n" unless @members;
        for my $m (@members) {
            die "dt: unknown member '$m'\n" unless $cfg->{models}{$m};
            if (defined $o->{model}) {
                die "dt: model must be @MODELS or recommended\n" unless grep { $_ eq $o->{model} } @MODELS, 'recommended';
                $cfg->{models}{$m}{model} = $o->{model} eq 'recommended' ? $def->{$m}{model} : $o->{model};
            }
            if (defined $o->{effort}) {
                die "dt: effort must be @EFFORTS or recommended\n" unless grep { $_ eq $o->{effort} } @EFFORTS, 'recommended';
                $cfg->{models}{$m}{effort} = $o->{effort} eq 'recommended' ? $def->{$m}{effort} : $o->{effort};
            }
        }
        $cfg->{models_chosen} = true;
        config_write($cfg);
        return print "updated: @members\n";
    }
    if ($sub eq 'reset') { $cfg->{models} = $def; $cfg->{models_chosen} = true; config_write($cfg); return print "models reset to recommended\n" }
    if ($sub eq 'choose') { $cfg->{models_chosen} = true; config_write($cfg); return print "recommended models accepted\n" }
    die "dt models: show|get M|set M --model X --effort Y|reset|choose\n";
}

sub c_grant {
    my ($sub, @a) = @_;
    need_init();
    my $s = state_read();
    $sub //= 'show';
    if ($sub eq 'set') { $s->{git_grants}{$_} = true for @a; state_write($s) }
    elsif ($sub eq 'revoke') { delete $s->{git_grants}{$_} for @a; state_write($s) }
    elsif ($sub ne 'show') { die "dt grant: show|set NAME...|revoke NAME...  (integration task_branches merges restore)\n" }
    print "grants: " . (join(', ', sort keys %{ $s->{git_grants} }) || 'none') . "\n";
}

sub c_branch {
    my ($sub) = @_;
    need_init();
    my $s = state_read();
    my $root = root();
    if (($sub // '') eq 'start') {
        die "dt: no 'integration' git grant for this goal\n" unless $s->{git_grants}{integration};
        die "dt: working tree not clean\n" if git_out($root, 'status', '--porcelain', '--', '.', @NOISE) ne '';
        $s->{original_branch} = git_out($root, 'rev-parse', '--abbrev-ref', 'HEAD');
        $s->{original_sha} = git_out($root, 'rev-parse', 'HEAD');
        my $b = "devteam/$s->{goal}";
        system('git', '-C', $root, 'switch', '-q', '-c', $b) == 0 or die "dt: could not create branch $b\n";
        $s->{integration_branch} = $b;
        state_write($s);
        return print "on $b (your branch '$s->{original_branch}' at " . substr($s->{original_sha}, 0, 8) . ")\n";
    }
    if (($sub // '') eq 'finish') {
        die "dt: no 'restore' git grant for this goal\n" unless $s->{git_grants}{restore};
        die "dt: no branch was started\n" unless length $s->{original_branch};
        die "dt: working tree not clean\n" if git_out($root, 'status', '--porcelain', '--', '.', @NOISE) ne '';
        system('git', '-C', $root, 'switch', '-q', $s->{original_branch}) == 0 or die "dt: could not switch back\n";
        my $now = git_out($root, 'rev-parse', $s->{original_branch});
        die "dt: WARNING your branch moved ($s->{original_sha} -> $now)\n" if $now ne $s->{original_sha};
        my $n = git_out($root, 'rev-list', '--count', "$s->{original_branch}..$s->{integration_branch}");
        return print "back on '$s->{original_branch}'; $s->{integration_branch} holds $n commit(s) ready for your review\n";
    }
    die "dt branch: start|finish\n";
}

sub allow_ready {
    my $g = config_read()->{gates};
    my %allow;
    for my $f ('settings.json', 'settings.local.json') {
        my $j = eval { jread(root() . "/.claude/$f") } or next;
        $allow{$_} = 1 for @{ $j->{permissions}{allow} // [] };
    }
    my @need = grep { length } map { (split ' ', $g->{$_} // '')[0] } qw(format typecheck test test_affected install);
    return 'n/a (no gate commands configured)' unless @need;
    my @miss = grep { my $w = $_; !grep { /^Bash\(\Q$w\E/ } keys %allow } @need;
    return @miss ? 'no (not allow-listed: ' . join(', ', @miss) . ')' : 'yes';
}
sub c_status {
    need_init();
    my $s = state_read();
    my $cfg = config_read();
    printf "status: %s%s\n", $s->{status}, length $s->{blocked_reason} ? " ($s->{blocked_reason})" : '';
    print "engaged: " . ($s->{engaged} ? "yes (session $s->{owner_session})" : 'no') . "\n";
    if (length $s->{goal}) {
        print "goal: $s->{goal}  lane: " . ($s->{lane} || '-') . "  lifecycle: " . ($s->{lifecycle} || '-') . "\n";
        print "agents spawned: $s->{spawns}/$s->{spawn_cap}   main-thread turns: $s->{main_turns}" . ($s->{turn_cap} ? "/$s->{turn_cap}" : '') . "\n";
        my $c = jread(goal_file('criteria.json'));
        printf "criteria: %d/%d pass\n", scalar(grep { $_->{passes} } @{ $c->{criteria} }), scalar @{ $c->{criteria} };
        my $oc = $s->{outcome} // {};
        print "outcome: " . uc($oc->{result}) . " ($oc->{pass}/$oc->{total} pass" . (@{ $oc->{open} } ? "; open: @{ $oc->{open} }" : '') . "): $oc->{why}\n" if $oc->{result};
    }
    if ($s->{engaged}) {
        my @live = live_others($s->{owner_session} // '');
        my %ok = acked($s->{goal});
        my $new = grep { !$ok{ $_->{id} } } @live;
        print 'other live sessions: ' . (@live ? scalar(@live) . ($new ? " ($new not acknowledged: dt sessions)" : ' (acknowledged)') : 'none') . "\n";
    }
    if (length $s->{goal} && (my $sc = DT::Scope::load())) {
        my @out = DT::Scope::outside($sc);
        print "scope $sc->{task}: " . (@out ? scalar(@out) . ' unresolved out-of-scope write(s): dt scope check' : 'clean') . "\n";
    }
    print "git grants: " . (join(', ', sort keys %{ $s->{git_grants} }) || 'none') . "\n";
    print "queued goals: " . scalar(@{ $s->{queue} }) . "\n";
    print "models chosen: " . ($cfg->{models_chosen} ? 'yes' : 'no') . "\n";
    my @miss = ($cfg->{models_chosen} ? () : 'models not chosen', -f ddir() . '/profile.md' ? () : 'no project profile', -f ddir() . '/standards.md' ? () : 'no standards');
    print "setup: " . (@miss ? "incomplete (" . join('; ', @miss) . ")" : 'complete') . "\n";
    print "unattended-ready: " . allow_ready() . "\n";
    my $t = check_seal();
    print "TAMPER: protected files changed outside dt: @$t\n" if @$t;
}

sub describe {
    my ($e) = @_;
    return substr($e->{id}, 0, 8) . ($e->{pid} ? " pid $e->{pid}" : '') . ($e->{name} ? " \"$e->{name}\"" : '') . ', '
        . ($e->{busy} ? 'busy' : "active $e->{age}s ago") . " (seen via $e->{via})";
}

sub c_sessions {
    my ($sub, @a) = @_;
    ($sub, @a) = ('list', $sub, @a) if defined $sub && $sub =~ /^--/;
    need_init();
    my ($o, $p) = opts(@a);
    my $s = state_read();
    my $self = $o->{self} // $s->{owner_session} // '';
    $sub //= 'list';
    return print map { "$_\n" } probe($o->{self} // $ENV{CLAUDE_SESSION_ID} // $self) if $sub eq 'probe';
    my @live = live_others($self);
    my %ok = acked($s->{goal});
    if ($sub eq 'ack') {
        my @ids;
        for my $want (@$p ? @$p : map { $_->{id} } @live) {
            my @m = grep { index($_->{id}, $want) == 0 } @live;
            die "dt sessions ack: no live session matches '$want'\n" unless @m;
            push @ids, map { $_->{id} } @m;
        }
        ack($s->{goal}, @ids);
        ledger_add({ event => 'sessions_ack', goal => $s->{goal}, sessions => \@ids });
        return print "acknowledged for $s->{goal}: " . join(', ', map { substr($_, 0, 8) } @ids) . "\n";
    }
    if ($sub eq 'check') { $EXIT = 1 if grep { !$ok{ $_->{id} } } @live; return }
    die "dt sessions [list|ack [id...]|check|probe] [--self SESSION]\n" unless $sub eq 'list';
    return print "other live sessions sharing this tree: none\n" unless @live;
    print "other live sessions sharing this tree: " . scalar(@live) . "\n";
    print '  ' . describe($_) . ($ok{ $_->{id} } ? '  [acknowledged]' : '') . "\n" for @live;
    my @w = foreign_writes();
    print "writes seen from other sessions (by our hooks):\n" . join('', map { "  $_->{path}  by " . substr($_->{session}, 0, 8) . " at " . strftime_local($_->{ts}) . "\n" } @w[0 .. ($#w > 9 ? 9 : $#w)]) if @w;
}
sub strftime_local { my @t = gmtime shift; sprintf '%02d:%02d:%02dZ', @t[2, 1, 0] }

# Attribute out-of-scope paths to another session when our hooks saw it write them.
sub scope_report {
    my ($s, @out) = @_;
    my $root = root();
    my %by;
    for my $w (foreign_writes()) {
        (my $rel = $w->{path}) =~ s{^\Q$root\E/(?:\.claude/worktrees/[^/]+/)?}{};
        $by{$rel} //= $w;
    }
    return map { my $w = $by{$_}; "  $_  " . ($w ? 'written by another session (' . substr($w->{session}, 0, 8) . ' at ' . strftime_local($w->{ts}) . ')' : 'writer unknown (the engineer, another session or a tool)') . "\n" } @out;
}

# dt scope start <task> <allowed...> | check | accept <path...>|--all
sub c_scope {
    my ($sub, @a) = @_;
    need_init();
    my ($o, $p) = opts(@a);
    $sub //= 'check';
    if ($sub eq 'start') {
        my ($task, @allow) = @$p;
        die "dt scope start <task-id> <allowed file|dir/|glob>...\n" unless length($task // '') && @allow;
        DT::Scope::start($task, @allow);
        return print "scope $task set: " . join(', ', @allow) . "\n";
    }
    my $s = DT::Scope::load() or return print "no scope set for this goal (dt scope start <task> <allowed files>)\n";
    my @out = DT::Scope::outside($s);
    if ($sub eq 'accept') {
        my @take = $o->{all} ? @out : @$p;
        die "dt scope accept <path>... | --all (the user's decision to keep these)\n" unless @take;
        DT::Scope::accept($s, @take);
        ledger_add({ event => 'scope_accept', task => $s->{task}, paths => \@take });
        return print 'accepted: ' . join(', ', @take) . "\n";
    }
    die "dt scope start|check|accept\n" unless $sub eq 'check';
    print "scope $s->{task}: allowed " . join(', ', @{ $s->{allow} }) . "\n";
    return print "in scope: nothing outside the allowed files has changed\n" unless @out;
    print "OUT OF SCOPE: " . scalar(@out) . " path(s) changed that this task was not meant to touch:\n", scope_report($s, @out),
        "Show the user. They decide: keep (dt scope accept <path>) or remove (only with their approval). Nothing closes until this is resolved.\n";
    $EXIT = 1;
}

# Which security triggers (risk.tsv) a change or a plan touches. Data, not judgement: the PM spawns the
# Security Engineer from this list, and it costs no model call.
sub c_risk {
    my ($sub, @a) = @_;
    need_init();
    my ($o, $p) = opts(@a);
    $sub //= 'diff';
    die "dt risk [diff [--base REF]] | planned <path>...\n" unless $sub =~ /^(?:diff|planned)$/;
    my ($hit, $count, $what);
    if ($sub eq 'planned') {
        die "dt risk planned <path>...\n" unless @$p;
        ($hit, $count) = risk_scan(undef, @$p);
        $what = 'planned';
    } else {
        my $base = $o->{base} // (state_read()->{original_sha} || 'HEAD');
        die "dt risk: '$base' is not a commit in this repository\n" unless git_out(root(), 'rev-parse', '--verify', '--quiet', "$base^{commit}");
        ($hit, $count) = risk_scan($base);
        $what = 'changed';
    }
    my @hit = @$hit;
    return print "risk: no triggers in $count $what file(s)\n" unless @hit;
    print 'risk: ' . scalar(@hit) . " trigger(s) in $count $what file(s); a security review is warranted\n";
    print map { "  $_\n" } @hit[ 0 .. ($#hit > 19 ? 19 : $#hit) ];
    print '  ... and ' . (@hit - 20) . " more\n" if @hit > 20;
}

# The triggers (risk.tsv) in a change since $base (paths, and the lines the change adds), or, with $base undef,
# in the given planned paths (names only). Returns (\@hits, file count).
sub risk_scan {
    my ($base, @planned) = @_;
    my @rules;
    for (split /\n/, slurp("$PLUGIN/risk.tsv") // '') {
        next if /^#/ || !/\S/;
        my ($kind, $where, $re) = split /\t/;
        push @rules, [ $kind, $where, qr/$re/i ];
    }
    my (%seen, @hit);
    my $add = sub {
        my ($kind, $path, $n) = @_;
        push @hit, "$kind: $path" . (defined $n ? ":$n" : '') if !$seen{"$kind $path"}++;
    };
    my $by_path = sub { my $f = shift; $f =~ $_->[2] && $add->($_->[0], $f) for grep { $_->[1] eq 'path' } @rules };
    my $by_line = sub {
        my ($f, $n, $text) = @_;
        return if length $text > 2000;
        $text =~ $_->[2] && $add->($_->[0], $f, $n) for grep { $_->[1] eq 'line' } @rules;
    };
    my $count;
    if (!defined $base) {
        $by_path->($_) for @planned;
        $count = scalar @planned;
    } else {
        my $root = root();
        my $changed = DT::Scope::changed($base);
        $by_path->($_) for sort keys %$changed;
        my ($file, $n, $hdr);    # lines the diff adds to tracked files
        for (split /\n/, git_out($root, 'diff', '-U0', '--no-color', '--no-ext-diff', '--no-renames', $base, '--', '.', @NOISE)) {
            if (/^diff --git/) { ($hdr, $file) = (1, undef); next }
            if ($hdr && /^\+\+\+ b\/(.*)/) { $file = $1; next }
            if (/^@@ -\S+ \+(\d+)/) { ($hdr, $n) = (0, $1); next }
            $by_line->($file, $n++, substr($_, 1)) if !$hdr && defined $file && /^\+/;
        }
        # a new file is all additions
        for my $f (grep { length } split /\0/, git_out($root, 'ls-files', '-o', '--exclude-standard', '-z', '--', '.', @NOISE)) {
            next unless -f "$root/$f" && -s _ < 524288 && -T _;
            open my $h, '<', "$root/$f" or next;
            while (my $l = <$h>) { chomp $l; $by_line->($f, $., $l) }
            close $h;
        }
        $count = scalar keys %$changed;
    }
    return (\@hit, $count);
}

# Did a Security Engineer finish a review while this goal was running? (The ledger is in order.)
sub security_ran {
    my ($goal) = @_;
    open my $h, '<', ddir() . '/log.jsonl' or return 0;
    my ($on, $ran) = (0, 0);
    while (my $l = <$h>) {
        my $r = eval { decode_json($l) } or next;
        if (($r->{event} // '') eq 'goal_confirm') { $on = ($r->{goal} // '') eq $goal ? 1 : 0 }
        $ran = 1 if $on && ($r->{event} // '') eq 'subagent_stop' && ($r->{agent_type} // '') eq 'devteam:security-engineer';
    }
    return $ran;
}

sub c_queue {
    my ($sub, @a) = @_;
    need_init();
    my $s = state_read();
    $sub //= 'show';
    if ($sub eq 'add') { push @{ $s->{queue} }, join(' ', @a); state_write($s); return print "queued (" . scalar(@{ $s->{queue} }) . ")\n" }
    if ($sub eq 'pop') { my $q = shift @{ $s->{queue} }; state_write($s); return print(($q // ''), "\n") }
    print map { ($_ + 1) . ". $s->{queue}[$_]\n" } 0 .. $#{ $s->{queue} };
}

sub c_resync { need_init(); seal(); print "protected files re-sealed (you accepted the current contents)\n" }

sub c_ledger {
    my ($sub) = @_;
    need_init();
    open my $h, '<', ddir() . '/log.jsonl' or return print "ledger: empty\n";
    my (%ev, %tok);
    while (<$h>) {
        my $r = eval { decode_json($_) } or next;
        $ev{ $r->{event} . ($r->{agent_type} ? " $r->{agent_type}" : '') . ($r->{outcome} ? " ($r->{outcome})" : '') }++;
        for my $m (keys %{ $r->{tokens} // {} }) { $tok{$m}{$_} += $r->{tokens}{$m}{$_} for keys %{ $r->{tokens}{$m} } }
    }
    print "events:\n", map { "  $_: $ev{$_}\n" } sort keys %ev;
    my $pr = config_read()->{prices};
    print "tokens by model (relative cost = (in+out) x price):\n";
    for my $m (sort keys %tok) {
        my ($i, $o, $cr) = map { $tok{$m}{$_} // 0 } qw(input output cache_read);
        my ($fam) = grep { $m =~ /$_/ } keys %$pr;
        printf "  %s: in=%d out=%d cache_read=%d cost=%.0f\n", $m, $i, $o, $cr, ($i + $o) * ($pr->{ $fam // '' } // 1);
    }
}
